# URL of the running Next.js server (no trailing slash)
NEXTJS_URL=http://localhost:3000

# Shared secret — must match INTERNAL_API_SECRET in Next.js .env.
# This placeholder is public (it is in this file, in git). Leaving it in place
# leaves /api/internal/rescrape/* guarded by a value anyone can read.
#   generate: openssl rand -hex 32
INTERNAL_API_SECRET=change-me-to-a-long-random-string

# When to run. Default is monthly at 03:00 on the 1st — a full pass is a paid AI
# run over every clinic, and medspa menus don't change week to week.
#   weekly: 0 3 * * 0     daily (expensive): 0 3 * * *
CRON_SCHEDULE=0 3 1 * *

# Clinics refreshed in parallel. Each one is an AI crawl on the same box that
# serves the public site, so keep this low — provider 429s are what blow the
# per-clinic time budget. Raise only after measuring with RESCRAPE_LIMIT.
RESCRAPE_CONCURRENCY=2

# Skip clinics refreshed within this many days. This is what makes a multi-hour
# pass restart-safe: a crashed or redeployed run resumes instead of starting over.
RESCRAPE_STALE_DAYS=21

# Also run once at startup. Off by default — otherwise every deploy triggers a
# full paid pass over the whole directory.
RESCRAPE_ON_BOOT=false

# Cap clinics per run. Unset = all. Use a small number to measure per-clinic
# wall time before choosing RESCRAPE_CONCURRENCY.
# RESCRAPE_LIMIT=5

# Per-request ceiling in ms. Node's undici enforces its own 300s headersTimeout
# regardless of this value, which is why the engine's per-clinic budget is 240s —
# so a slow clinic becomes a recorded "skipped" run instead of an opaque timeout.
# RESCRAPE_REQUEST_TIMEOUT_MS=480000
