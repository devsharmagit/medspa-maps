# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
# NOT "/node_modules" — that is root-anchored and left cron-server/node_modules
# (1731 files, 36 MB) tracked. This form matches at any depth.
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
scripts/g99/.env.g99

pages-docs
treatment-service-images